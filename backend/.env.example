# Copie este arquivo para .env e preencha com valores reais.
# Nunca versione o .env com segredos.

# ---------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------
DB_HOST=localhost
DB_USER=agendatech
DB_PASSWORD=troque-esta-senha
DB_NAME=agendatech
DB_PORT=3306

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
PORT=3000

# Segredo usado para assinar os JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres; a API não inicia sem ele.
JWT_SECRET=

# Opcional: identificação do emissor/audiência dos tokens.
JWT_ISSUER=agendatech-api
JWT_AUDIENCE=agendatech-web

# Validade do token de acesso (ex.: 7d, 12h).
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# CORS / URLs
# ---------------------------------------------------------------
# Domínio do frontend (usado também nos links de e-mail).
FRONTEND_URL=http://localhost:5173

# URL pública em https usada nos retornos do checkout do Asaas.
# O Asaas não aceita localhost. Em desenvolvimento, aponte para um
# túnel que chegue a esta API; as rotas /assinatura/sucesso,
# /assinatura/cancelado e /assinatura/expirado redirecionam para
# o FRONTEND_URL. Em produção, use o domínio público do frontend.
ASAAS_CALLBACK_BASE_URL=

# Lista separada por vírgula de origens adicionais permitidas no CORS.
# Em produção, informe os domínios reais aqui.
CORS_ORIGINS=

# Use 1 quando a API estiver atrás de um proxy reverso confiável
# (nginx, Cloudflare, etc.). Deixe vazio em desenvolvimento.
TRUST_PROXY=

# ---------------------------------------------------------------
# E-mail (recuperação de senha)
# ---------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@example.com
# Em provedores como Gmail, use uma senha de aplicativo.
EMAIL_PASSWORD=
EMAIL_FROM="Agenda Tech <no-reply@example.com>"

# ---------------------------------------------------------------
# Pagamento (Asaas)
# ---------------------------------------------------------------
# sandbox ou production.
ASAAS_ENV=sandbox

# URL da API do Asaas. Se ficar vazia, é escolhida conforme ASAAS_ENV.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Chave de API gerada no painel do Asaas.
ASAAS_API_KEY=

# Identificação enviada no header User-Agent.
ASAAS_USER_AGENT=Agenda Tech

# Token enviado pelo Asaas no header asaas-access-token.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=

# Configure no painel do Asaas a URL pública:
# https://seu-dominio.com/webhooks/asaas
