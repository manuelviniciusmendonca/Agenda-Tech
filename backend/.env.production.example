# ===============================================================
# MODELO DE CONFIGURAÇÃO DE PRODUÇÃO
# ===============================================================
# Copie este arquivo para .env no servidor e preencha os valores.
# NUNCA versione o .env real. NUNCA reutilize este arquivo como .env
# de desenvolvimento: ele aponta para a API de PRODUÇÃO do Asaas e
# qualquer teste pode gerar cobrança real.

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Segredo usado para assinar os JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo de 32 caracteres; a API não inicia sem ele.
JWT_SECRET=

JWT_ISSUER=agendatech-api
JWT_AUDIENCE=agendatech-web
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------
DB_HOST=localhost
DB_USER=agendatech
DB_PASSWORD=
DB_NAME=agendatech
DB_PORT=3306

# ---------------------------------------------------------------
# CORS / URLs
# ---------------------------------------------------------------
# Domínio real do frontend, com https e SEM barra no final.
FRONTEND_URL=https://app.seudominio.com.br

# Base pública em https usada nos retornos do checkout do Asaas.
# Deve ser a RAIZ do site, SEM /webhooks/asaas.
# O código acrescenta sozinho /assinatura/sucesso, /cancelado e /expirado.
# Exemplo: https://app.seudominio.com.br
ASAAS_CALLBACK_BASE_URL=https://app.seudominio.com.br

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=https://app.seudominio.com.br

# Use 1 quando a API estiver atrás de proxy reverso confiável
# (nginx, Cloudflare, etc.). Em produção com proxy, use 1.
TRUST_PROXY=1

# ---------------------------------------------------------------
# E-mail (recuperação de senha)
# ---------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@seudominio.com.br
EMAIL_PASSWORD=
EMAIL_FROM="Agenda Tech <no-reply@seudominio.com.br>"

# ---------------------------------------------------------------
# Pagamento (Asaas) - PRODUÇÃO
# ---------------------------------------------------------------
ASAAS_ENV=production
ASAAS_API_URL=https://api.asaas.com/v3

# Chave de API de PRODUÇÃO (painel do Asaas).
ASAAS_API_KEY=

ASAAS_USER_AGENT=Agenda Tech

# Token enviado pelo Asaas no header asaas-access-token.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=

# No painel do Asaas, cadastre o webhook em:
# https://app.seudominio.com.br/webhooks/asaas
# Eventos: PAYMENT_CREATED, PAYMENT_CONFIRMED, PAYMENT_RECEIVED,
# PAYMENT_OVERDUE, PAYMENT_REFUNDED, SUBSCRIPTION_CREATED,
# SUBSCRIPTION_UPDATED, SUBSCRIPTION_INACTIVATED, SUBSCRIPTION_DELETED.
